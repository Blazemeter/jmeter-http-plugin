# Aligns editors with .gitattributes (eol=lf) and checkstyle.xml
# (NewlineAtEndOfFile=lf, FileTabCharacter, Indentation basicOffset=2).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2

[*.{xml,xsd,xsl}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
# Markdown often uses trailing spaces for hard line breaks
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2
